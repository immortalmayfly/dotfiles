# ~/.zprofile - Sourced for login shells

# XDG Base Directory Specification
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Core Environment
export EDITOR='nvim'
export VISUAL='nvim'
export PAGER='gum pager --soft-wrap'
export LS_COLORS="di=34:ln=3;36:so=1;35:pi=35:ex=1;33:bd=1;4;32:cd=1;32:su=1;4;33:sg=1;4;33:tw=1;4;34:ow=4;34:st=1;34:or=3;31:mi=1;31:do=1;35"
export GOPATH="$HOME/.go"
export GOBIN="$GOPATH/bin"
export PNPM_HOME="${XDG_DATA_HOME}/pnpm"
export MANPAGER='nvim +Man!'

# PATH Management
# typeset -U path links the $path array and $PATH variable and ensures uniqueness
typeset -g -aU path
path=(
  $HOME/.local/share/mise/shims(N-/:A)
  $HOME/.local/bin(N-/:A)
  $GOBIN(N-/:A)
  $HOME/.{bun,cabal,cargo,deno,ghcup,mint,pixi,flutter}/bin(N-/:A)
  $HOME/.dotnet/tools(N-/:A)
  $HOME/.spicetify(N-/:A)
  $PNPM_HOME/bin(N-/:A)
  $path
)
export PATH
