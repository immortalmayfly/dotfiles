{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii/tw.txt",
        "padding": {
            "top": 3,
            "right": 3,
            "left": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        "break",
        "break",
        {
            "type": "title",
            "keyWidth": 10
        },
        {
            "type": "custom",
            "format": "~~~~~~~~~~~"
        },
        {
            "type": "os",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "kernel",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "packages",
	    "combined": true,
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "shell",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "terminal",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "wm",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "memory",
            "format": "{used} / {total}",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "uptime",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "media",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "player",
            "key": "~ ",
            "keyColor": "34"
        },
        "break"
    ]
}
