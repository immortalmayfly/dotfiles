# ~/.bashrc.d/bashrc

### SECTION 2: Interactive Session Guard

# Return early if not running interactively
[[ $- != *i* ]] && return


### SECTION 3: Shell Options & Behavior

# Improved globbing and directory handling
shopt -s histappend checkwinsize globstar extglob cmdhist lithist autocd cdspell dirspell histverify dotglob
shopt -s no_empty_cmd_completion 2>/dev/null
shopt -s checkjobs

# Fix terminal settings
stty werase undef 2>/dev/null


### SECTION 4: History Management

export HISTFILE="$XDG_STATE_HOME/bashist"
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTTIMEFORMAT="%F %T "
export HISTCONTROL="ignoreboth:erasedups"
export HISTIGNORE="exit:history:history*:l:ls:ll:lla:la:pwd:clear:bg:fg:jobs:ff:nf:fastfetch:neofetch"

# History completion function
_history_completion() {
    if [[ "${COMP_WORDS[COMP_CWORD]}" == -* ]]; then
        mapfile -t COMPREPLY < <(compgen -W "-c -d -a -n -r -w -p -s" -- "${COMP_WORDS[COMP_CWORD]}")
    fi
}
complete -F _history_completion history


### SECTION 5: Aliases

# Core Overrides
alias vim="nvim"
alias vi="nvim"
alias nv="nvim"
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias dir='dir --color=auto'
alias vdir='vdir --color=auto'

# Modern CLI Replacements (checks existence)
if command -v bat >/dev/null; then
    alias cat='bat --paging=never'
    alias batl='bat --paging=always'
fi

if command -v rg >/dev/null; then
    alias grep='rg'
fi

if command -v fd >/dev/null; then
    alias find='fd'
fi

if command -v duf >/dev/null; then
    alias df='duf'
fi

if command -v dust >/dev/null; then
    alias du='dust'
fi

# Enhanced Directory Listing (lsd/eza preference)
if command -v lsd >/dev/null; then
  alias ls='lsd -al --color=always --group-directories-first --icon=always'
  alias la='lsd -a --color=always --group-directories-first --icon=always'
  alias ll='lsd -l --color=always --group-directories-first --icon=always'
  alias lt='lsd -aT --color=always --group-directories-first --icon=always'
  alias l.="lsd -a | grep -e '^\.'"
elif command -v eza >/dev/null; then
  alias ls='eza -al --color=always --group-directories-first --icons'
  alias la='eza -a --color=always --group-directories-first --icons'
  alias ll='eza -l --color=always --group-directories-first --icons'
  alias lt='eza -aT --color=always --group-directories-first --icons'
else
  alias ls='ls --color=auto'
  alias la='ls -a --color=auto'
  alias ll='ls -l --color=auto'
fi

# Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."

# System & Fetch
alias ff="fastfetch"
alias nf="fastfetch -c neofetch"
alias neofetch="fastfetch -c neofetch"
alias top="btop"
alias hw='/usr/sbin/hwinfo --short'
alias jctl="journalctl -p 3 -xb"
alias cavitty='kitten panel --edge=background cava'

# Package Managers
if [[ -f /etc/os-release ]]; then
    __distro_id=$(. /etc/os-release && echo "$ID")
    case "$__distro_id" in
        opensuse*|suse)
            alias zup='sudo zypper dist-upgrade --no-recommends --allow-vendor-change'
            alias zin='sudo zypper install'
            alias znr='sudo zypper install --no-recommends'
            alias zif='zypper info'
            alias zrm='sudo zypper rm --clean-deps'
            alias zrf='sudo zypper refresh'
            alias zrr='sudo zypper removerepo'
            alias zlr='zypper repos --sort-by-priority'
            ;;
        void)
            alias xrm='sudo xbps-remove -ROof'
            alias xin='sudo xbps-install -Suv'
            ;;
    esac
    unset __distro_id
fi

# Utilities
alias tarnow='tar -acf'
alias wget='wget -c'
alias psmem='ps auxf | sort -nr -k 4'
alias psmem10='ps auxf | sort -nr -k 4 | head -10'
[[ -x "$(command -v procs)" ]] && alias fprocs='procs --no-header --color=always | fzf --preview "procs {1}"'

# Media & Misc
alias spot-a="spotdl --output '/home/kb/Downloads/MP3/Artists/{album-artist}/{album} ({year})/{artists} - {title}.{output-ext}' --bitrate 320k"
alias spot-p="spotdl --output '/home/kb/Downloads/MP3/Playlists/{list-name}/{artists} - {title}.{output-ext}' --bitrate 320k"
alias r='R_AUTO_START=true nvim'
alias gearlever='flatpak run it.mijorus.gearlever'
alias instaloader='instaloader -b brave --no-metadata-json --no-captions --no-profile-pic'


### SECTION 6: Functions

# Create and enter directory
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Go up N directories
up() {
    local d=""
    limit=$1
    for ((i=1 ; i <= limit ; i++)); do
        d=$d"../"
    done
    cd $d
}

# Extract any archive
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"     ;;
            *.tar.gz)    tar xzf "$1"     ;;
            *.bz2)       bunzip2 "$1"     ;;
            *.rar)       unrar x "$1"     ;;
            *.gz)        gunzip "$1"      ;;
            *.tar)       tar xf "$1"      ;;
            *.tbz2)      tar xjf "$1"     ;;
            *.tgz)       tar xzf "$1"     ;;
            *.zip)       unzip "$1"       ;;
            *.Z)         uncompress "$1"  ;;
            *.7z)        7z x "$1"        ;;
            *)           echo "'$1' cannot be extracted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# Optimized image conversion to PNG
img2png() {
  local force=0
  [[ "$1" =~ ^(-f|--force)$ ]] && force=1 && shift
  [[ $# -eq 0 ]] && echo "Usage: img2png [-f] image..." && return 1
  command -v magick >/dev/null || { echo "magick not found"; return 1; }

  local img
  for img in "$@"; do
    [[ ! -f "$img" ]] && continue
    local out="${img%.*}.png"
    [[ -f "$out" && $force -eq 0 ]] && continue
    magick "$img" -strip -define png:compression-level=9 "$out" && echo "$img -> $out"
  done
}

# Interactive file search with previews
fsearch() {
    local preview
    if command -v bat >/dev/null; then
        preview="bat --style=numbers --color=always --line-range :100 {}"
    else
        preview="head -100 {}"
    fi
    
    if command -v fd >/dev/null; then
        fd --type f --hidden --exclude .git | fzf --preview="$preview"
    else
        find . -type f | fzf --preview="$preview"
    fi
}

# FZF History Search
fhist() {
    eval $(history | fzf +s --tac | sed 's/^[ ]*[0-9]*[ ]*//')
}

# Network info
myip() {
  printf "Local: %s\n" "$(ip route get 1 | awk '{print $7; exit}' 2>/dev/null || echo 'N/A')"
  printf "Public: %s\n" "$(curl -s https://ipinfo.io/ip || echo 'N/A')"
}

# Timed notifications
remindme() {
  local t="$1"; shift
  notify-send "Reminder" "$*"
  sleep "$t" && notify-send "Time's up" "$*"
}

# Password generator
genpass() {
  tr -dc 'A-Za-z0-9!@#$%^&*()_+' < /dev/urandom | head -c "${1:-16}"; echo
}

# Yazi integration (cwd sync)
y() {
	local tmp
	tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	local cwd
	command yazi "$@" --cwd-file="$tmp"
	if [[ -f "$tmp" ]]; then
		cwd=$(<"$tmp")
		if [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
			builtin cd "$cwd" || return
		fi
	fi
	rm -f "$tmp"
}


### SECTION 7: Lazy-Loaded Tool Integrations

# FZF Configuration
export FZF_COMPLETION_AUTO_COMMON_PREFIX=true
export FZF_TAB_COMPLETION_PROMPT='❯ '
export FZF_DEFAULT_OPTS="--height 40% --border --cycle --sort --bind 'tab:down,shift-tab:up,ctrl-j:down,ctrl-k:up,enter:accept,backward-eof:abort'"

# FZF Tab Completion (Initializes on first <Tab>)
__fzf_tab_init() {
    local plugin="${HOME}/.bashrc.d/.fzf-tab.bash"
    if [[ -f "$plugin" ]] && command -v fzf >/dev/null 2>&1; then
        if source "$plugin" 2>/dev/null && declare -F fzf_tab >/dev/null; then
            bind -x '"\t": fzf_tab'
            fzf_tab
            return
        fi
    fi
    bind '"\t": complete'
}
bind -x '"\t": __fzf_tab_init'

# Zoxide (Lazy load on 'z' or 'zi')
z() {
    unset -f z zi
    if command -v zoxide >/dev/null; then
        eval "$(zoxide init bash)"
        z "$@"
    else
        echo "zoxide not found"
    fi
}
zi() {
    unset -f z zi
    if command -v zoxide >/dev/null; then
        eval "$(zoxide init bash)"
        zi "$@"
    else
        echo "zoxide not found"
    fi
}


mise() {
    unset -f mise
    if command -v mise >/dev/null; then
        eval "$(command mise activate bash)"
        mise "$@"
    else
        command mise "$@"
    fi
}

# UV Completions (Lazy load on 'uv' or 'uvx')
uv() {
    unset -f uv
    if command -v uv >/dev/null; then
        eval "$(uv generate-shell-completion bash)"
        uv "$@"
    else
        command uv "$@"
    fi
}
uvx() {
    unset -f uvx
    if command -v uvx >/dev/null; then
        eval "$(uvx --generate-shell-completion bash)"
        uvx "$@"
    else
        command uvx "$@"
    fi
}

# Deferred environment scripts
[[ -r "$HOME/.opam/opam-init/init.sh" ]] && . "$HOME/.opam/opam-init/init.sh" >/dev/null 2>&1
[[ -r "$XDG_DATA_HOME/coursier/env.sh" ]] && . "$XDG_DATA_HOME/coursier/env.sh" >/dev/null 2>&1


### SECTION 8: Visuals & Prompt

# LS Colors
export LS_COLORS="di=34:ln=3;36:so=1;35:pi=35:ex=1;33:bd=1;4;32:cd=1;32:su=1;4;33:sg=1;4;33:tw=1;4;34:ow=4;34:st=1;34:or=3;31:mi=1;31:do=1;35"

# Standard Fallback Prompt
__prompt_newline() {
    [[ -z "$FIRST_PROMPT" ]] && FIRST_PROMPT=1 || printf "\n"
}
PROMPT_COMMAND="__prompt_newline"
PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

# Oh-My-Posh (Initializes only if present, provides modern prompt)
export OMP_THEME="$XDG_DATA_HOME/omp/themes/zen.omp.toml"
if [[ -x "$(command -v oh-my-posh)" ]]; then
    eval "$(oh-my-posh init bash --config $OMP_THEME)"
fi

# Share history across all terminals in real-time (Zsh sharehistory equivalent)
# This is appended at the end to wrap any prompt commands set by the prompt theme.
PROMPT_COMMAND="history -a; history -n; ${PROMPT_COMMAND:+${PROMPT_COMMAND};}"
