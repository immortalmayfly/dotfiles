{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ascii/logo.txt",
    "padding": {
      "top": 2,
      "right": 3,
      "left": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10
    },
    "break",
    {
      "type":     "os",
      "key":      " ",
      "keyColor": "33"
    },
    {
      "type":     "kernel",
      "key":      "󰒋 ",
      "keyColor": "33"
    },
    {
      "type":     "packages",
      "combined": true,
      "key":      "󰏖 ",
      "keyColor": "33"
    },
    {
      "type":     "shell",
      "key":      "󰞷 ",
      "keyColor": "33"
    },
    {
      "type":     "terminal",
      "key":      "󰆍 ",
      "keyColor": "33"
    },
    {
      "type":     "wm",
      "key":      "󰨇 ",
      "keyColor": "33"
    },
    {
      "type":     "memory",
      "key":      "󰍛 ",
      "keyColor": "33"
    },
    {
      "type":     "uptime",
      "key":      "󰅐 ",
      "keyColor": "33"
    },
    {
      "type":     "command",
      "key":      "󰃭 ",
      "keyColor": "33",
      "text":     "~/.config/fastfetch/scripts/os-age"
    },
    "break",
    "colors",
    "break",
    "break"
  ]
}
