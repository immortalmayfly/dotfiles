* {
    background: rgba(0,54,64,0.8);
    primary: #55d6f3;
    primary-fixed: #abedff;
    primary-fixed-dim: #55d6f3;
    on-primary: #003640;
    on-primary-fixed: #001f26;
    on-primary-fixed-variant: #004e5c;
    primary-container: #004e5c;
    on-primary-container: #abedff;
    secondary: #84d2e6;
    secondary-fixed: #abedff;
    secondary-fixed-dim: #84d2e6;
    on-secondary: #003640;
    on-secondary-fixed: #001f26;
    on-secondary-fixed-variant: #004e5c;
    secondary-container: #004e5c;
    on-secondary-container: #abedff;
    tertiary: #aec6ff;
    tertiary-fixed: #d8e2ff;
    tertiary-fixed-dim: #aec6ff;
    on-tertiary: #112f60;
    on-tertiary-fixed: #001a42;
    on-tertiary-fixed-variant: #2c4678;
    tertiary-container: #2c4678;
    on-tertiary-container: #d8e2ff;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #0f131c;
    on-surface: #dfe2ef;
    on-surface-variant: #bfc6dc;
    outline: #8990a5;
    outline-variant: #3f4759;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #dfe2ef;
    inverse-on-surface: #2d303a;
    inverse-primary: #00687a;
    surface-dim: #0f131c;
    surface-bright: #353943;
    surface-container-lowest: #0a0e17;
    surface-container-low: #181b25;
    surface-container: #1c2029;
    surface-container-high: #262a33;
    surface-container-highest: #31353f;
    surface-tint: #55d6f3;
}
