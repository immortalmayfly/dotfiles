#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    album_art_position: Right,
    album_art_width_percent: 40,
    default_album_art_path: None,
    draw_borders: true,
    show_song_table_header: true,
    symbols: (
        song: "🎵",
        dir: "󰉋 ",
        marker: "\u{e0b0}",
    ),
    progress_bar: (
        symbols: [
            "█",
            "█",
            "█",
            "█",
            "█",
        ],
        track_style: (
            fg: "#1c2029",
            bg: None,
        ),
        elapsed_style: (
            fg: "#55d6f3",
            bg: None,
        ),
        thumb_style: (
            fg: "#55d6f3",
            bg: None,
        ),
    ),
    scrollbar: (
        symbols: [
            "",
            "│",
            " ",
            " ",
        ],
        track_style: (
            fg: "#55d6f3",
        ),
        ends_style: (),
        thumb_style: (
            fg: "#55d6f3",
        ),
    ),
    browser_column_widths: [
        20,
        38,
        42,
    ],
    text_color: "#84d2e6",
    header_background_color: None,
    modal_background_color: "#003640",
    tab_bar: (
        enabled: true,
        active_style: (
            fg: "#0f131c",
            bg: "#55d6f3",
            modifiers: "Bold",
        ),
        inactive_style: (),
    ),
    borders_style: (
        fg: "#55d6f3",
    ),
    highlighted_item_style: (
        fg: "#55d6f3",
        modifiers: "Bold",
    ),
    current_item_style: (
        fg: "#55d6f3",
        bg: "#004e5c",
        modifiers: "Bold",
    ),
    highlight_border_style: (
        fg: "#55d6f3",
    ),
    song_table_format: [
        (
            prop: (
                kind: Property(Artist),
                default: (
                    kind: Text("Unknown"),
                ),
            ),
            width: "20%",
        ),
        (
            prop: (
                kind: Property(Title),
                default: (
                    kind: Text("Unknown"),
                ),
            ),
            width: "35%",
        ),
        (
            prop: (
                kind: Property(Album),
                default: (
                    kind: Text("Unknown Album"),
                ),
            ),
            width: "30%",
        ),
        (
            prop: (
                kind: Property(Duration),
                default: (
                    kind: Text("-"),
                ),
            ),
            width: "15%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                pane: Pane(Header),
                size: "3",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                pane: Pane(ProgressBar),
                size: "1",
            ),
        ],
    ),
    header: (
        rows: [
            (
                left: [
                    (
                        kind: Text("["),
                        style: (
                            fg: "#55d6f3",
                            modifiers: "Bold",
                        ),
                    ),
                    (
                        kind: Property(Status(State)),
                        style: (
                            fg: "#55d6f3",
                            modifiers: "Bold",
                        ),
                    ),
                    (
                        kind: Text("]"),
                        style: (
                            fg: "#55d6f3",
                            modifiers: "Bold",
                        ),
                    ),
                ],
                center: [
                    (
                        kind: Property(Song(Title)),
                        style: (
                            fg: "#55d6f3",
                            modifiers: "Bold",
                        ),
                        default: (
                            kind: Text("No Song"),
                            style: (
                                fg: "#55d6f3",
                                modifiers: "Bold",
                            ),
                        ),
                    ),
                ],
                right: [
                    (
                        kind: Text("Vol: "),
                        style: (
                            fg: "#55d6f3",
                            modifiers: "Bold",
                        ),
                    ),
                    (
                        kind: Property(Status(Volume)),
                        style: (
                            fg: "#55d6f3",
                        ),
                    ),
                    (
                        kind: Text("% "),
                        style: (
                            fg: "#55d6f3",
                            modifiers: "Bold",
                        ),
                    ),
                ],
            ),
            (
                left: [
                    (
                        kind: Property(Status(Elapsed)),
                    ),
                    (
                        kind: Text(" / "),
                    ),
                    (
                        kind: Property(Status(Duration)),
                    ),
                    (
                        kind: Text(" ("),
                    ),
                    (
                        kind: Property(Status(Bitrate)),
                    ),
                    (
                        kind: Text(" kbps)"),
                    ),
                ],
                center: [
                    (
                        kind: Property(Song(Artist)),
                        style: (
                            fg: "#55d6f3",
                            modifiers: "Bold",
                        ),
                        default: (
                            kind: Text("No song"),
                            style: (
                                fg: "#55d6f3",
                                modifiers: "Bold",
                            ),
                        ),
                    ),
                    (
                        kind: Text(" - "),
                    ),
                    (
                        kind: Property(Song(Album)),
                        default: (
                            kind: Text("No song"),
                        ),
                    ),
                ],
                right: [
                    (
                        kind: Property(Widget(States(
                            active_style: (
                                fg: "#dfe2ef",
                                modifiers: "Bold",
                            ),
                            separator_style: (
                                fg: "#dfe2ef",
                            ),
                        ))),
                        style: (
                            fg: "#84d2e6",
                        ),
                    ),
                ],
            ),
        ],
    ),
)