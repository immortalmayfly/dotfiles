layout {
    background-color "transparent"

    focus-ring {
        active-color   "#55d6f3"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#55d6f3"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color          "#00000070"
    }

    tab-indicator {
        active-color   "#55d6f3"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color          "#55d6f380"
    }
}

recent-windows {
    highlight {
        active-color   "#004e5c"
        urgent-color   "#ffb4ab"
    }
}
